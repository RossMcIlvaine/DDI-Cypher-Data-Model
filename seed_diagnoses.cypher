MATCH (drug:Drug {name: row.core_drug})
MATCH (diag:Diagnosis {long_title: row.long_title})
MERGE (drug)-[r:ASSOCIATED_WITH]->(diag)
  ON CREATE SET
    r.admission_count        = row.admission_count,
    r.avg_severity           = row.avg_severity,
    r.total_drug_admissions  = row.total_drug_admissions,
    r.pct_of_drug_admissions = row.pct_of_drug_admissions,
    r.drug_labels            = row.drug_labels;
